# ──────────────────────────────────────────────────────────────────────────────
# notSafe. - CONFIGURATION D'ENVIRONNEMENT (EXEMPLE)
# Copiez ce fichier vers .env et modifiez les valeurs selon vos besoins.
# ──────────────────────────────────────────────────────────────────────────────

# 1. Sécurité Backend
# Générez une clé forte (ex: python -c 'import secrets; print(secrets.token_hex(32))')
SECRET_KEY=votre_cle_secrete_ici_doit_etre_longue_et_complexe

# 2. Base de Données Relationnelle (SQLAlchemy)
# Local (SQLite) : sqlite:///notsafe.db
# Production (PostgreSQL) : postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///notsafe.db

# 3. Base de Données NoSQL (MongoDB)
# Local : mongodb://localhost:27017/notsafe_db
# Docker : mongodb://mongo:27017/notsafe_db
MONGO_URI=mongodb://localhost:27017/notsafe_db

# 4. Configuration du Cache (Flask-Caching)
# Options : SimpleCache, RedisCache, etc.
CACHE_TYPE=SimpleCache

# 5. Environnement de l'application
FLASK_APP=run.py
FLASK_DEBUG=1
