# ============================================================
# notSafe. — Root .gitignore
# Covers: Python backend, React frontend, Docker, OS, IDE
# ============================================================

# ── Environment variables (NEVER commit) ─────────────────────
.env
.env.local
.env.*.local
**/.env
**/.env.local

# ── Python ───────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv/
*.egg-info/
*.egg
pip-log.txt
pip-delete-this-directory.txt

# ── Flask / SQLAlchemy ───────────────────────────────────────
instance/
*.db
*.sqlite
*.sqlite3

# ── Tests ────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Node / React ─────────────────────────────────────────────
node_modules/
**/node_modules/
dist/
build/
.next/
out/
.cache/
.eslintcache
.parcel-cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────
*.log

# ── CI/CD ────────────────────────────────────────────────────
.github/
.gitlab-ci.yml
.travis.yml
