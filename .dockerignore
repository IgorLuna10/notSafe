# ============================================================
# notSafe. — Root .dockerignore
# Prevents unnecessary files entering any Docker build context.
# ============================================================

# ── Environment ──────────────────────────────────────────────
.env
.env.local
.env.*.local
**/.env

# ── Python ───────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
*.egg-info/
backend/.pytest_cache/
backend/instance/
*.db
*.sqlite

# ── Node / React ─────────────────────────────────────────────
node_modules/
**/node_modules/
frontend/dist/
frontend/build/
.eslintcache
npm-debug.log*
yarn-debug.log*

# ── Tests & Coverage ─────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage/
.nyc_output/

# ── IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Git ──────────────────────────────────────────────────────
.git/
.gitignore

# ── Docs / CI ────────────────────────────────────────────────
*.md
LICENSE
.github/
.gitlab-ci.yml
